# Secrets and machine-local state — never commit
.env
.env.*
*.pem
*.key
*.pfx
auth.json
credentials.json
service.json
opencode.db
opencode.db-*
*.sqlite
*.sqlite3

# Local OpenCode project state
.opencode/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log

# Browser-driven verification output.
# Narrow, not a global *.png: a README diagram or docs screenshot is a real
# source file and must stay committable.
.playwright-cli/
verification/artifacts/

# node_modules is not ignored here on purpose. The project has zero
# dependencies, so it should never exist; if it appears, that is a bug worth
# seeing rather than a routine occurrence to hide.

# User-specific files
opencode-dashboard.html
